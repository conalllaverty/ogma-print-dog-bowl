.DS_Store
.env
.venv/
**/__pycache__/
**/*.pyc
node_modules/
.next/
out/*
!out/.gitkeep
backend/generator/cooper_dog_bowl/
*.egg-info/
dist/
web/out/
.cursor/

# Scratch folder for files awaiting manual deletion (the remote-device bridge
# cannot unlink files on the user's disk, so they get moved here instead).
_to_delete/

# Transient 3MF written while rewriting project settings in place.
*.tmp.3mf

# macOS/FUSE artefacts left by editing files over the remote-device bridge.
.fuse_hidden*

# NOTE: backend/generator/bambu_work/ is deliberately TRACKED. Despite the name,
# those .3mf files are read-only INPUT assets — build_bambu_project.py opens them
# for the plate preview thumbnails it embeds in every output project. Nothing in
# the repo writes them. Untracking them breaks a fresh clone.

# Derived Fusion mesh exports (OBJ/MTL dumps + a zip of themselves). 256 MB, stored
# four times over, and regenerable from backend/generator/boucle_lamp_fusion.py.
# The printable deliverables under production/ and coupons/ ARE tracked.
design/**/fusion/
*.obj
*.mtl

# macOS duplicate-on-copy artefacts ("… 2", "… 3")
* [0-9]/
* [0-9].*
