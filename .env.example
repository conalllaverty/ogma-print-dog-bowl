# Copy to .env for local development. Every value here is the default the code
# already uses, so an empty .env behaves identically — this file exists to make
# the knobs discoverable.
#
# For deployment settings and what they should be in production, see DEPLOY.md.

APP_ENV=local
PORT=8000
PUBLIC_API_URL=http://localhost:8000

# Comma-separated. Parsed into a list before it reaches Starlette — handing it
# the raw string turns the origin check into a substring match.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Jobs and the preview cache both live under here. On a deployment this must be
# a mounted volume: the preview cache IS the files on disk, so an ephemeral
# filesystem throws away every built preview on each deploy.
JOBS_ROOT=./data/jobs

# Read by the web app, not the API — the address its /api/v1 proxy forwards to.
PIPELINE_API_URL=http://127.0.0.1:8000

# --- Retention ---------------------------------------------------------------
# A single completed job leaves ~14 MB behind (meshes, visuals, the .3mf) and
# nothing else deletes it.
#
# Jobs expire by age; previews evict least-recently-used down to a size budget,
# because a preview is pure cache — its key is a hash of the geometry, so the
# bytes can never be wrong, only absent.
JOB_RETENTION_HOURS=168
PREVIEW_CACHE_MAX_MB=512
REAPER_INTERVAL_MINUTES=60

# --- Rate limiting -----------------------------------------------------------
# /generate and /preview share the single global build lock, so one caller in a
# loop can queue every other customer behind them. Per-caller token buckets;
# over budget returns 429 with Retry-After.
RATE_LIMIT_ENABLED=true
GENERATE_PER_HOUR=20
PREVIEW_PER_HOUR=120
